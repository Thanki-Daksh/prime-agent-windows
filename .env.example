# ==============================================================================
# Prime Agent Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to `.env` and fill in your API key(s).
# Prime Agent will automatically pick them up on startup.
# ==============================================================================

# --- Anthropic (Claude 3.5 Sonnet, Claude 3 Opus, Claude 3.5 Haiku) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- OpenAI (GPT-4o, o1, o3-mini) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Google Gemini (Gemini 2.0 Flash, Gemini 1.5 Pro) ---
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Prime Intellect Inference ---
# https://app.primeintellect.ai/
PRIME_API_KEY=

# --- DeepSeek (DeepSeek V3, DeepSeek R1) ---
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# --- Groq (Ultra-fast Llama 3.3, DeepSeek R1) ---
# https://console.groq.com/keys
GROQ_API_KEY=

# --- OpenRouter (Aggregator for all models) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- xAI (Grok 2) ---
# https://console.x.ai/
XAI_API_KEY=

# --- Mistral AI (Mistral Large, Codestral) ---
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# --- Cerebras ---
# https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# --- GitHub Copilot / Token ---
GITHUB_TOKEN=

# --- Hugging Face ---
# https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Web Search Skill (Serper) ---
# https://serper.dev/
SERPER_API_KEY=
